# =============================================================================
# Plexsol Business Manager — Environment Variables
# =============================================================================
# Copy this file to `.env` at the repository root and fill in real values.
# Never commit real credentials.
# =============================================================================

# --- Database (Neon PostgreSQL) ---
# Use the Neon connection string from the Neon console.
# Prefer the pooled connection string for the API / Prisma Client runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional: direct (non-pooled) URL for Prisma migrations
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Session / auth cookie. Generate a long random secret (min 16 chars).
# Used by cookie-parser to sign the httpOnly session cookie.
SESSION_SECRET="replace-with-a-long-random-secret"
SESSION_COOKIE_NAME="plexsol_session"
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Dev seed admin password (Phase 3). Never use in production as-is.
SEED_ADMIN_PASSWORD="ChangeMe-Plexsol-Admin-1!"

# --- Web ---
VITE_API_URL="http://localhost:4000"

# --- Worker ---
WORKER_POLL_INTERVAL_MS=15000
WORKER_ENABLED=true

# --- Email (Phase 7+) — leave blank until configured ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Plexsol Business Manager <noreply@plexsol.com>"

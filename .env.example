# =============================================================================
# Plexsol Business Manager — Environment Variables
# =============================================================================
# Copy this file to `.env` at the repository root and fill in real values.
# Never commit real credentials. See docs/deployment.md for production notes.
# =============================================================================

# --- Database (Neon PostgreSQL) ---
# Prefer the pooled connection string for the API / Prisma Client / worker runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional: direct (non-pooled) URL for Prisma migrations
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
# Exact browser origin allowed for credentialed CORS (production: https://your-web-host)
CORS_ORIGIN="http://localhost:5173"

# Session / auth cookie. Generate a long random secret (min 16 chars).
SESSION_SECRET="replace-with-a-long-random-secret"
SESSION_COOKIE_NAME="plexsol_session"
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Dev seed admin password. Never use the default in production.
SEED_ADMIN_PASSWORD="ChangeMe-Plexsol-Admin-1!"
# ALLOW_DB_SEED=true  # required to seed when NODE_ENV=production

# --- Web ---
# Public API origin for production builds (leave empty in local Vite proxy mode)
VITE_API_URL="http://localhost:4000"

# --- Worker ---
WORKER_POLL_INTERVAL_MS=15000
WORKER_ENABLED=true
# Set to a port (e.g. 4010) so managed hosts can probe /health and /health/ready
WORKER_HEALTH_PORT=4010

# --- Email (optional) — leave SMTP_HOST blank to use console transport ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Plexsol Business Manager <noreply@plexsol.com>"

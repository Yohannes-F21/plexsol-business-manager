{
  "name": "@plexsol/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@plexsol/database": "workspace:*",
    "@plexsol/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/morgan": "^1.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

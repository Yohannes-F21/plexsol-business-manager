// Plexsol Business Manager — Prisma schema (Phase 2)
// Money: Decimal/NUMERIC only. Never float. Reporting currency: ETB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  ADMIN
  STAFF
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum BillingFrequency {
  MONTHLY
  YEARLY
}

enum MaintenanceAgreementStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum BillingCycleStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

enum SubscriptionBillingPeriod {
  MONTHLY
  YEARLY
  CUSTOM
}

enum PaymentMethodType {
  BANK_TRANSFER
  CASH
  CARD
  MOBILE_MONEY
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  ACTION_REQUIRED
  SYSTEM
}

enum ScheduledEventType {
  SUBSCRIPTION_REMINDER
  MAINTENANCE_DUE_REMINDER
  OVERDUE_PAYMENT_EMAIL
}

enum ScheduledEventStatus {
  PENDING
  AWAITING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum EmailJobStatus {
  PENDING
  AWAITING_APPROVAL
  APPROVED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum EmailDeliveryStatus {
  SUCCESS
  TEMPORARY_FAILURE
  PERMANENT_FAILURE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CORRECT
  ALLOCATE
  APPROVE
  CANCEL
}

// =============================================================================
// Auth & settings
// =============================================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions              Session[]
  settingsUpdated       Setting[]              @relation("SettingUpdatedBy")
  clientPaymentsCreated ClientPayment[]        @relation("PaymentCreatedBy")
  expensesCreated       Expense[]              @relation("ExpenseCreatedBy")
  renewalsConfirmed     SubscriptionRenewal[]  @relation("RenewalConfirmedBy")
  notifications         Notification[]
  eventsApproved        ScheduledEvent[]       @relation("EventApprovedBy")
  emailJobsApproved     EmailJob[]             @relation("EmailApprovedBy")
  auditLogs             AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

// =============================================================================
// Currencies & rates (historical rates preserved)
// =============================================================================

model Currency {
  code          String  @id @db.Char(3)
  name          String
  symbol        String
  decimalPlaces Int     @default(2) @map("decimal_places")
  isActive      Boolean @default(true) @map("is_active")
  /// Exactly one reporting currency (ETB) enforced via partial unique index in SQL.
  isReporting   Boolean @default(false) @map("is_reporting")

  exchangeRatesFrom     ExchangeRate[]           @relation("RateFrom")
  exchangeRatesTo       ExchangeRate[]           @relation("RateTo")
  maintenanceAgreements MaintenanceAgreement[]
  billingCycles         MaintenanceBillingCycle[]
  clientPayments        ClientPayment[]
  projects              Project[]
  subscriptions         Subscription[]
  renewals              SubscriptionRenewal[]
  expenses              Expense[]

  @@map("currencies")
}

model ExchangeRate {
  id               String   @id @default(uuid()) @db.Uuid
  fromCurrencyCode String   @map("from_currency_code") @db.Char(3)
  toCurrencyCode   String   @map("to_currency_code") @db.Char(3)
  /// Units of toCurrency per 1 unit of fromCurrency. High precision; never float.
  rate             Decimal  @db.Decimal(19, 8)
  effectiveAt      DateTime @map("effective_at") @db.Timestamptz(3)
  source           String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  fromCurrency Currency @relation("RateFrom", fields: [fromCurrencyCode], references: [code])
  toCurrency   Currency @relation("RateTo", fields: [toCurrencyCode], references: [code])

  clientPayments ClientPayment[]
  expenses       Expense[]

  @@unique([fromCurrencyCode, toCurrencyCode, effectiveAt])
  @@index([toCurrencyCode, effectiveAt])
  @@map("exchange_rates")
}

// =============================================================================
// Payment methods
// =============================================================================

model PaymentMethod {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @unique
  type      PaymentMethodType
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientPayments ClientPayment[]
  expenses       Expense[]

  @@map("payment_methods")
}

// =============================================================================
// Clients & projects
// =============================================================================

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  company   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  projects Project[]
  payments ClientPayment[]

  @@index([name])
  @@map("clients")
}

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  clientId     String        @map("client_id") @db.Uuid
  name         String
  description  String?
  status       ProjectStatus @default(IN_PROGRESS)
  /// Agreed development price — independent of payment / allocation status.
  agreedPrice  Decimal       @map("agreed_price") @db.Decimal(19, 4)
  currencyCode String        @default("ETB") @map("currency_code") @db.Char(3)
  startDate    DateTime?     @map("start_date") @db.Date
  endDate      DateTime?     @map("end_date") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  client               Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  currency             Currency              @relation(fields: [currencyCode], references: [code])
  /// Zero or one maintenance agreement per project (unique on projectId).
  maintenanceAgreement MaintenanceAgreement?
  paymentAllocations   PaymentAllocation[]

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

// =============================================================================
// Maintenance agreements & billing cycles
// =============================================================================

model MaintenanceAgreement {
  id              String                      @id @default(uuid()) @db.Uuid
  /// At most one agreement per project.
  projectId       String                      @unique @map("project_id") @db.Uuid
  billingFrequency BillingFrequency           @map("billing_frequency")
  amount          Decimal                     @db.Decimal(19, 4)
  currencyCode    String                      @map("currency_code") @db.Char(3)
  startDate       DateTime                    @map("start_date") @db.Date
  endDate         DateTime?                   @map("end_date") @db.Date
  status          MaintenanceAgreementStatus  @default(ACTIVE)
  notes           String?
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currency     Currency                   @relation(fields: [currencyCode], references: [code])
  billingCycles MaintenanceBillingCycle[]

  @@index([status])
  @@map("maintenance_agreements")
}

model MaintenanceBillingCycle {
  id                     String             @id @default(uuid()) @db.Uuid
  maintenanceAgreementId String             @map("maintenance_agreement_id") @db.Uuid
  periodStart            DateTime           @map("period_start") @db.Date
  periodEnd              DateTime           @map("period_end") @db.Date
  dueDate                DateTime           @map("due_date") @db.Date
  amount                 Decimal            @db.Decimal(19, 4)
  currencyCode           String             @map("currency_code") @db.Char(3)
  /// Maintained by allocation triggers; must never exceed amount.
  amountAllocated        Decimal            @default(0) @map("amount_allocated") @db.Decimal(19, 4)
  status                 BillingCycleStatus @default(PENDING)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  agreement   MaintenanceAgreement @relation(fields: [maintenanceAgreementId], references: [id], onDelete: Restrict)
  currency    Currency             @relation(fields: [currencyCode], references: [code])
  allocations PaymentAllocation[]

  @@index([maintenanceAgreementId, dueDate])
  @@index([status, dueDate])
  @@map("maintenance_billing_cycles")
}

// =============================================================================
// Client payments & allocations
// =============================================================================

model ClientPayment {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  amount          Decimal  @db.Decimal(19, 4)
  currencyCode    String   @map("currency_code") @db.Char(3)
  /// Snapshot in reporting currency (ETB) at payment time.
  amountEtb       Decimal  @map("amount_etb") @db.Decimal(19, 4)
  exchangeRateId  String?  @map("exchange_rate_id") @db.Uuid
  paymentMethodId String?  @map("payment_method_id") @db.Uuid
  paidAt          DateTime @map("paid_at") @db.Timestamptz(3)
  reference       String?
  notes           String?
  /// Maintained by allocation triggers; must never exceed amount.
  amountAllocated Decimal  @default(0) @map("amount_allocated") @db.Decimal(19, 4)
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client        Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  currency      Currency           @relation(fields: [currencyCode], references: [code])
  exchangeRate  ExchangeRate?      @relation(fields: [exchangeRateId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  createdBy     User?              @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  allocations   PaymentAllocation[]

  @@index([clientId, paidAt])
  @@map("client_payments")
}

/// Each allocation targets exactly one project XOR one billing cycle (SQL CHECK).
/// Ownership and over-allocation enforced by triggers + transactional helpers.
model PaymentAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  clientPaymentId String   @map("client_payment_id") @db.Uuid
  amount          Decimal  @db.Decimal(19, 4)
  projectId       String?  @map("project_id") @db.Uuid
  billingCycleId  String?  @map("billing_cycle_id") @db.Uuid
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clientPayment ClientPayment            @relation(fields: [clientPaymentId], references: [id], onDelete: Restrict)
  project       Project?                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  billingCycle  MaintenanceBillingCycle? @relation(fields: [billingCycleId], references: [id], onDelete: Restrict)

  @@index([clientPaymentId])
  @@index([projectId])
  @@index([billingCycleId])
  @@map("payment_allocations")
}

// =============================================================================
// Subscriptions, renewals, expenses
// =============================================================================

model ExpenseCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  /// System categories (e.g. subscription_renewal) cannot be deleted casually.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  expenses Expense[]

  @@map("expense_categories")
}

model SubscriptionCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("subscription_categories")
}

model Subscription {
  id                 String                    @id @default(uuid()) @db.Uuid
  name               String
  vendor             String?
  categoryId         String?                   @map("category_id") @db.Uuid
  amount             Decimal                   @db.Decimal(19, 4)
  currencyCode       String                    @map("currency_code") @db.Char(3)
  billingPeriod      SubscriptionBillingPeriod @map("billing_period")
  startDate          DateTime                  @map("start_date") @db.Date
  expirationDate     DateTime                  @map("expiration_date") @db.Date
  status             SubscriptionStatus        @default(ACTIVE)
  /// Days before expiration to remind, e.g. [30, 14, 7, 1]
  reminderDaysBefore Int[]                     @default([30, 14, 7, 1]) @map("reminder_days_before")
  url                String?
  notes              String?
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  category SubscriptionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  currency Currency              @relation(fields: [currencyCode], references: [code])
  renewals SubscriptionRenewal[]

  @@index([expirationDate, status])
  @@map("subscriptions")
}

/// Confirmed renewal creates exactly one associated expense (expenseId required + unique).
model SubscriptionRenewal {
  id                     String   @id @default(uuid()) @db.Uuid
  subscriptionId         String   @map("subscription_id") @db.Uuid
  renewedAt              DateTime @map("renewed_at") @db.Timestamptz(3)
  previousExpirationDate DateTime @map("previous_expiration_date") @db.Date
  newExpirationDate      DateTime @map("new_expiration_date") @db.Date
  amount                 Decimal  @db.Decimal(19, 4)
  currencyCode           String   @map("currency_code") @db.Char(3)
  /// Exactly one expense per renewal — uniqueness prevents duplication.
  expenseId              String   @unique @map("expense_id") @db.Uuid
  confirmedById          String?  @map("confirmed_by_id") @db.Uuid
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  currency     Currency     @relation(fields: [currencyCode], references: [code])
  expense      Expense      @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  confirmedBy  User?        @relation("RenewalConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([subscriptionId, renewedAt])
  @@map("subscription_renewals")
}

model Expense {
  id              String   @id @default(uuid()) @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  amount          Decimal  @db.Decimal(19, 4)
  currencyCode    String   @map("currency_code") @db.Char(3)
  amountEtb       Decimal  @map("amount_etb") @db.Decimal(19, 4)
  exchangeRateId  String?  @map("exchange_rate_id") @db.Uuid
  description     String
  incurredAt      DateTime @map("incurred_at") @db.Timestamptz(3)
  paymentMethodId String?  @map("payment_method_id") @db.Uuid
  /// True only for expenses created via subscription renewal flow.
  isSubscriptionRenewal Boolean @default(false) @map("is_subscription_renewal")
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category      ExpenseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currency      Currency             @relation(fields: [currencyCode], references: [code])
  exchangeRate  ExchangeRate?        @relation(fields: [exchangeRateId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  renewal       SubscriptionRenewal?

  @@index([incurredAt])
  @@index([categoryId])
  @@map("expenses")
}

// =============================================================================
// Notifications, scheduling, email
// =============================================================================

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String?          @map("user_id") @db.Uuid
  type       NotificationType @default(INFO)
  title      String
  body       String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model ScheduledEvent {
  id               String               @id @default(uuid()) @db.Uuid
  type             ScheduledEventType
  entityType       String               @map("entity_type")
  entityId         String               @map("entity_id")
  scheduledFor     DateTime             @map("scheduled_for") @db.Timestamptz(3)
  status           ScheduledEventStatus @default(PENDING)
  payload          Json?
  requiresApproval Boolean              @default(false) @map("requires_approval")
  approvedById     String?              @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?            @map("approved_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  approvedBy User?      @relation("EventApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  emailJobs  EmailJob[]

  @@index([status, scheduledFor])
  @@index([type, entityId])
  @@map("scheduled_events")
}

model EmailTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  subject     String
  bodyHtml    String   @map("body_html")
  bodyText    String?  @map("body_text")
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobs EmailJob[]

  @@map("email_templates")
}

model EmailJob {
  id               String         @id @default(uuid()) @db.Uuid
  templateId       String?        @map("template_id") @db.Uuid
  scheduledEventId String?        @map("scheduled_event_id") @db.Uuid
  toEmail          String         @map("to_email")
  subject          String
  bodyHtml         String         @map("body_html")
  bodyText         String?        @map("body_text")
  status           EmailJobStatus @default(PENDING)
  attemptCount     Int            @default(0) @map("attempt_count")
  /// Temporary failures retry up to three total attempts.
  maxAttempts      Int            @default(3) @map("max_attempts")
  lastError        String?        @map("last_error")
  approvedById     String?        @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?      @map("approved_at") @db.Timestamptz(3)
  sentAt           DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  template       EmailTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduledEvent ScheduledEvent?        @relation(fields: [scheduledEventId], references: [id], onDelete: SetNull)
  approvedBy     User?                  @relation("EmailApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  attempts       EmailDeliveryAttempt[]

  @@index([status, createdAt])
  @@map("email_jobs")
}

model EmailDeliveryAttempt {
  id               String              @id @default(uuid()) @db.Uuid
  emailJobId       String              @map("email_job_id") @db.Uuid
  attemptNumber    Int                 @map("attempt_number")
  status           EmailDeliveryStatus
  providerResponse String?             @map("provider_response")
  errorMessage     String?             @map("error_message")
  attemptedAt      DateTime            @default(now()) @map("attempted_at") @db.Timestamptz(3)

  emailJob EmailJob @relation(fields: [emailJobId], references: [id], onDelete: Cascade)

  @@unique([emailJobId, attemptNumber])
  @@index([emailJobId])
  @@map("email_delivery_attempts")
}

// =============================================================================
// Audit log (financial corrections must be auditable)
// =============================================================================

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorUserId String?    @map("actor_user_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

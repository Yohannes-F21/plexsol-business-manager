{
  "name": "plexsol-business-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plexsol Business Manager — subscription, client, maintenance, and financial management",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @plexsol/shared build",
    "dev": "pnpm run --parallel --filter @plexsol/web --filter @plexsol/api --filter @plexsol/worker dev",
    "dev:web": "pnpm --filter @plexsol/web dev",
    "dev:api": "pnpm --filter @plexsol/api dev",
    "dev:worker": "pnpm --filter @plexsol/worker dev",
    "build": "pnpm run -r --sort build",
    "typecheck": "pnpm run -r --sort typecheck",
    "lint": "pnpm run -r --sort lint",
    "db:generate": "pnpm --filter @plexsol/database generate",
    "db:push": "pnpm --filter @plexsol/database push",
    "db:migrate": "pnpm --filter @plexsol/database migrate",
    "db:migrate:deploy": "pnpm --filter @plexsol/database migrate:deploy",
    "db:seed": "pnpm --filter @plexsol/database seed",
    "db:studio": "pnpm --filter @plexsol/database studio",
    "db:test": "pnpm --filter @plexsol/database test",
    "test:api": "pnpm --filter @plexsol/api test",
    "clean": "pnpm run -r --if-present clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
